{
  "name": "dsp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist && tsc -b && vite build",
    "preview:build": "tsc -b && vite build --mode pre",
    "typecheck": "tsc --incremental --noEmit",
    "preview": "vite preview",
    "preview:preview": "vite preview --port 9002",
    "graphql:doc1": "rm -rf src/generated/generated-graphql/* && rm -rf src/generated/generated-graphql/* && node generate-docs.mjs",
    "graphql:doc": "node generate-docs.mjs",
    "graphql:codegen": "graphql-codegen --config codegen.ts && biome check --write src/generated/generated-ts/*/*.ts",
    "graphql:rebuild": "pnpm graphql:doc && pnpm graphql:codegen"
  },
  "dependencies": {
    "@ant-design/icons": "catalog",
    "@dnd-kit/core": "catalog",
    "@dnd-kit/sortable": "catalog",
    "@dnd-kit/utilities": "catalog",
    "@mh-repo/apis": "workspace:*",
    "@mh-repo/types": "workspace:*",
    "@mh-repo/ui": "workspace:*",
    "@mh-repo/utils": "workspace:*",
    "@tanstack/react-query": "catalog",
    "ahooks": "catalog",
    "dayjs": "catalog",
    "echarts": "catalog",
    "graphql-request": "catalog",
    "graphql-tag": "catalog",
    "lodash-es": "catalog",
    "nprogress": "catalog",
    "pinyin-pro": "^3.29.3",
    "qiankun": "catalog",
    "react": "catalog",
    "react-dom": "catalog",
    "react-router": "catalog",
    "vite-plugin-qiankun": "catalog",
    "vite-plugin-svgr": "catalog",
    "zustand": "catalog"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/typescript": "catalog",
    "@graphql-codegen/typescript-graphql-request": "catalog",
    "@graphql-codegen/typescript-operations": "catalog",
    "@graphql-tools/load": "catalog",
    "@graphql-tools/url-loader": "catalog",
    "@graphql-tools/utils": "catalog",
    "@parcel/watcher": "catalog",
    "@tailwindcss/vite": "catalog",
    "@tanstack/react-query-devtools": "catalog",
    "@types/nprogress": "catalog",
    "@types/react": "catalog",
    "@types/react-dom": "catalog",
    "@vitejs/plugin-react-swc": "catalog",
    "autoprefixer": "catalog",
    "graphql": "catalog:",
    "less": "catalog",
    "postcss": "catalog",
    "rimraf": "catalog:",
    "tailwindcss": "catalog",
    "typescript": "catalog",
    "vite": "catalog",
    "vite-bundle-analyzer": "catalog",
    "vite-plugin-inspect": "catalog"
  }
}
