FROM golang:1.23-alpine AS builder

WORKDIR /app

# 安装 git（部分依赖可能需要）
RUN apk add --no-cache git

# 复制 go.mod/go.sum 并下载依赖（利用 Docker 缓存）
COPY go.mod go.sum ./
RUN go env -w GOPROXY=https://goproxy.cn,direct && go mod download

# 复制全部源码
COPY . .

# 编译测试二进制（不运行）
RUN go test -c -o /app/test-binary ./test

# ---------- 运行阶段 ----------
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata mysql-client \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app

COPY --from=builder /app/test-binary /app/test-binary
COPY --from=builder /app/test/config.yaml /app/test/config.yaml

# 复制启动脚本
COPY test/scripts/run.sh /app/run.sh
COPY test/scripts/wait.sh /app/scripts/wait.sh
RUN chmod +x /app/run.sh /app/scripts/wait.sh

ENV TEST_CONFIG_PATH=/app/test/config.yaml

ENTRYPOINT ["/app/run.sh"]
